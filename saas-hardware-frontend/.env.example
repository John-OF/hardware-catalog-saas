# Copiar a .env (que NO va en git, ACC-6) y ajustar.
#
# Todo lo que empieza por VITE_ se mete en el bundle y lo ve cualquiera que
# abra la tienda: aqui solo van valores publicos, nunca una clave secreta.

# URL base de la API. Sin ella, http://localhost:8000/api.
VITE_API_URL=http://localhost:8000/api

# Site key del widget de Turnstile (la PUBLICA; la secreta va en la API).
# Esta es la de prueba de Cloudflare, que aprueba siempre: vale para local.
# Sin ninguna, el formulario de resenas queda deshabilitado.
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Hosts de la propia plataforma, separados por comas (INF-9). En ellos "/" es la
# landing; en cualquier otro, "/" resuelve la tienda por dominio propio. En
# produccion hay que ponerlo al hacer el build o la landing no sale nunca.
# Sin ella, localhost,127.0.0.1.
# VITE_PLATFORM_HOSTS=plataforma.com,www.plataforma.com
