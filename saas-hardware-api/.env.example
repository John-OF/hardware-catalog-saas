APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Base del SPA. La API la usa para el enlace de recuperacion de contrasenia y
# para redirigir las rutas publicas cuando quien entra no es un crawler.
# En produccion: https://tudominio.com (sin barra final).
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En local 'log' basta: el mensaje (con el enlace de reset) se escribe
# en storage/logs/laravel.log en vez de enviarse.
#
# En PRODUCCION hay que poner un mailer real o la recuperacion de contrasenia
# no llega a nadie y el dueño pierde el acceso a su tienda (SAAS-2). Opciones:
#   SMTP:   MAIL_MAILER=smtp + MAIL_HOST/PORT/USERNAME/PASSWORD del proveedor
#   Resend: MAIL_MAILER=resend + RESEND_API_KEY
#   SES:    MAIL_MAILER=ses   + AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_DEFAULT_REGION
# MAIL_FROM_ADDRESS debe ser una direccion del dominio verificado en el proveedor.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Clave de Resend si MAIL_MAILER=resend (requiere `composer require resend/resend-laravel`).
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (anti-bot de resenias publicas).
# Sin esta clave, fuera de local las resenias se rechazan con 502: nunca se
# aprueba por defecto. La clave de PRUEBA de Cloudflare aprueba cualquier token,
# asi que no debe usarse en produccion.
# Panel: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
